generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Badge {
  badge_id    Int    @id @default(autoincrement())
  code        String @unique
  name        String
  description String
}

model Friendship {
  id         Int      @id @default(autoincrement())
  user_id    Int
  friend_id  Int
  status     String   @default("PENDING")
  created_at DateTime @default(now())

  user   users @relation("FriendshipUser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  friend users @relation("FriendshipFriend", fields: [friend_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, friend_id])
  @@index([friend_id], map: "Friendship_friend_id_fkey")
  @@index([friend_id, status])
  @@index([status])
}

model Habit {
  habit_id       Int      @id @default(autoincrement())
  user_id        Int
  name           String
  frequency      String
  daily_deadline String?
  goal           String?
  is_shared      Boolean  @default(false)
  status         String   @default("active")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  shared_habits SharedHabit[] @relation("SharedHabitHabit")

  @@index([user_id], map: "Habit_user_id_fkey")
  @@index([user_id, status])
  @@index([status])
}

model HabitLog {
  log_id         Int      @id @default(autoincrement())
  habit_id       Int
  user_id        Int
  log_date       DateTime
  completed_at   DateTime @default(now())
  points_awarded Int      @default(10)

  @@unique([habit_id, user_id, log_date])
  @@index([user_id], map: "HabitLog_user_id_fkey")
  @@index([user_id, log_date])
  @@index([habit_id, log_date])
}

model SharedHabit {
  id         Int @id @default(autoincrement())
  habit_id   Int
  owner_id   Int
  partner_id Int

  habit   Habit @relation("SharedHabitHabit", fields: [habit_id], references: [habit_id], onDelete: NoAction, onUpdate: NoAction)
  owner   users @relation("SharedHabitOwner", fields: [owner_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  partner users @relation("SharedHabitPartner", fields: [partner_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([habit_id, partner_id])
  @@index([owner_id], map: "SharedHabit_owner_id_fkey")
  @@index([partner_id], map: "SharedHabit_partner_id_fkey")
}

model UserBadge {
  id         Int      @id @default(autoincrement())
  user_id    Int
  badge_id   Int
  awarded_at DateTime @default(now())

  @@unique([user_id, badge_id])
  @@index([badge_id], map: "UserBadge_badge_id_fkey")
}

model UserScore {
  id             Int @id @default(autoincrement())
  user_id        Int @unique
  total_score    Int @default(0)
  level          Int @default(1)
  current_streak Int @default(0)
  longest_streak Int @default(0)
}

model users {
  user_id             Int      @id @default(autoincrement())
  username            String   @unique
  name                String   @default("")
  email               String   @unique
  password            String
  profile_picture_url String?
  created_at          DateTime @default(now())

  friendships_as_user   Friendship[]   @relation("FriendshipUser")
  friendships_as_friend Friendship[]   @relation("FriendshipFriend")
  shared_habits_as_owner SharedHabit[] @relation("SharedHabitOwner")
  shared_habits_as_partner SharedHabit[] @relation("SharedHabitPartner")
  role                Role     @default(USER)
}

enum Role {
  USER
  ADMIN
}
